# ==============================================================================
# LinkedIn Content Copilot — Backend Environment Variables
# ==============================================================================
# Copy this file to backend/.env and fill in real values for your environment.
# NEVER commit a real .env file. Every value below is a placeholder or a safe
# local-development default — no real secret, key, or credential is present
# in this file.
# ==============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# One of: debug | info | warn | error | silent
LOG_LEVEL=debug

# --- MongoDB -----------------------------------------------------------------
# Any MongoDB 5+ compatible server. In this development sandbox a
# MongoDB-wire-protocol-compatible server (FerretDB) stands in for real
# mongod — see README.md for why. Point this at a real MongoDB/Atlas
# instance in any normal environment; no code change is required.
MONGODB_URI=mongodb://127.0.0.1:27017/linkedin_copilot

# --- Redis ---------------------------------------------------------------
# Used for: sessions, LinkedIn/auth rate limiting, the scheduler's
# distributed dispatch lock, and the OAuth CSRF state token.
REDIS_URL=redis://127.0.0.1:6379

# --- RabbitMQ ----------------------------------------------------------------
# Used for the async "publish this post to LinkedIn" job queue, consumed
# by the worker process (src/app/worker.js).
RABBITMQ_URL=amqp://127.0.0.1:5672

# --- CORS ---------------------------------------------------------------
# Origin the frontend is served from. Only relevant if the frontend calls
# the API cross-origin instead of through Vite's dev proxy.
CORS_ORIGIN=http://localhost:5173

# --- Sessions -----------------------------------------------------------
# Long random string used to sign the session-ID cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The session itself (including the user id) lives server-side in Redis;
# only an opaque signed id ever reaches the browser cookie.
SESSION_SECRET=dev-only-insecure-secret-change-me
SESSION_COOKIE_NAME=copilot.sid
# Leave blank for localhost; set to your domain (e.g. .example.com) in production.
SESSION_COOKIE_DOMAIN=
# Session lifetime in milliseconds. 604800000 = 7 days.
SESSION_MAX_AGE_MS=604800000

# --- Passwords -----------------------------------------------------------
BCRYPT_SALT_ROUNDS=10

# --- Frontend URL ---------------------------------------------------------
# Where the browser is redirected back to after the LinkedIn OAuth flow.
FRONTEND_URL=http://localhost:5173

# --- LinkedIn OAuth --------------------------------------------------------
# Register an app at https://www.linkedin.com/developers/apps to get a
# client id/secret. LINKEDIN_REDIRECT_URI must exactly match the redirect
# URL configured on that LinkedIn app (protocol, host, and port included).
# Required scopes: openid, profile, w_member_social.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4000/api/linkedin/callback

# --- Token encryption -------------------------------------------------------
# Symmetric key LinkedIn access/refresh tokens are encrypted with (AES-256-GCM)
# before being stored in MongoDB — see src/shared/utils/crypto.js. Generate
# one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Not required for the app to boot — only enforced when a LinkedIn
# connection is actually attempted.
TOKEN_ENCRYPTION_KEY=

# --- AI provider -----------------------------------------------------------
# AI generation sits behind the AIProvider abstraction (src/modules/ai/
# providers/AIProvider.js); OpenAIProvider is the only concrete
# implementation right now. Any OpenAI-compatible chat-completions API key
# works. Not required for the app to boot — only enforced when an AI
# endpoint is actually called.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
